ARCH ?= riscv64
PROFILE ?= debug
PLATFORM ?= ls2k1000

SMP ?= 1
MEM ?= 256M
SMOKE_TIMEOUT ?= 120
SMP_SMOKE_TIMEOUT ?= 240
STRESS_ARCHES ?= $(ARCH)
STRESS_SMPS ?= $(SMP)
STRESS_MEMS ?= $(MEM)
STRESS_PROFILES ?= $(PROFILE)
STRESS_LOOPS ?= 1
STRESS_TIMEOUT ?= $(SMP_SMOKE_TIMEOUT)
M5_SOAK_LOOPS ?= 200
M5_RELEASE_SOAK_LOOPS ?= 20

KERNEL_PACKAGE ?= myos-kernel
KERNEL_BINARY ?= myos-kernel

QEMU_ARGS ?=

# 既有 clippy 债务豁免：kernel/arch 在 `-- -D warnings` 下存在大量历史 clippy
# 错误（dead-code 测试脚手架、未注释 unsafe 块、样式类），并非本分支引入。
# 对已知噪声类 -A 收敛门禁范围；其余 lint 仍按 -D warnings 视为错误。
CLIPPY_ALLOW = -A dead-code -A unexpected-cfgs -A unused-variables -A unused-mut \
	-A unused-imports -A unused-assignments \
	-A clippy::undocumented-unsafe-blocks -A clippy::needless-borrow \
	-A clippy::unnecessary-map-or -A clippy::unnecessary-cast \
	-A clippy::collapsible-if -A clippy::too-many-arguments \
	-A clippy::type-complexity -A clippy::needless-range-loop \
	-A clippy::manual-range-contains -A clippy::explicit-auto-deref \
	-A clippy::comparison-chain -A clippy::redundant-closure \
	-A clippy::forget-non-drop -A clippy::byte-char-slices \
	-A clippy::boxed-local -A dropping_references \
	-A unused-unsafe -A clippy::identity-op -A unreachable-code \
	-A clippy::write-with-newline -A clippy::manual-unwrap-or \
	-A clippy::diverging-sub-expression -A clippy::useless-format \
	-A clippy::unnecessary-lazy-evaluations

export ARCH
export PROFILE
export PLATFORM
export SMP
export MEM
export KERNEL_PACKAGE
export KERNEL_BINARY
export QEMU_ARGS
export STRESS_ARCHES
export STRESS_SMPS
export STRESS_MEMS
export STRESS_PROFILES
export STRESS_LOOPS
export STRESS_TIMEOUT
export M5_SOAK_LOOPS
export M5_RELEASE_SOAK_LOOPS

# ============================================================================
# Competition submission targets
# ============================================================================
.PHONY: all kernel-rv kernel-la kernel-ls2k1000 kernel-visionfive2 \
        ls2k1000-mkimage check-ls2k1000-image check-visionfive2-image
all: kernel-rv kernel-la kernel-ls2k1000 kernel-visionfive2 uImage uImage-vf2
	@echo "=== Competition artifacts ==="
	@ls -lh kernel-rv kernel-la kernel-ls2k1000 kernel-visionfive2 uImage uImage-vf2 2>/dev/null || true
	@echo "all: done"

kernel-rv:
	@ARCH=riscv64 PLATFORM=qemu-virt PROFILE=release ./scripts/build.sh
	@cp build/riscv64/cargo/riscv64imac-unknown-none-elf/release/myos-kernel kernel-rv

kernel-la:
	@ARCH=loongarch64 PLATFORM=qemu-virt PROFILE=release ./scripts/build.sh
	@cp build/loongarch64/cargo/loongarch64-unknown-none-softfloat/release/myos-kernel kernel-la

kernel-ls2k1000: ls2k1000-mkimage
	@ARCH=loongarch64 PLATFORM=ls2k1000 PROFILE=release ./scripts/build.sh
	@cp build/loongarch64/cargo/loongarch64-unknown-none-softfloat/release/myos-kernel kernel-ls2k1000

kernel-visionfive2:
	@ARCH=riscv64 PLATFORM=visionfive2 PROFILE=release ./scripts/build.sh
	@cp build/riscv64/cargo/riscv64imac-unknown-none-elf/release/myos-kernel kernel-visionfive2

# LS2K1000 host mkimage: build or reuse the vendor U-Boot mkimage.
# Override with: LS2K1000_MKIMAGE=/path/to/mkimage make kernel-ls2k1000
.PHONY: ls2k1000-mkimage
ls2k1000-mkimage:
	@./scripts/build-ls2k1000-mkimage.sh

# LS2K1000 产物链: kernel ELF -> kernel.bin -> 厂商 mkimage -> uImage -> check
kernel-ls2k1000.elf: kernel-ls2k1000
	@cp kernel-ls2k1000 $@

kernel-ls2k1000.bin: kernel-ls2k1000
	@python3 scripts/elf-to-uimage.py --raw kernel-ls2k1000 $@
	@ls -lh $@

kernel-ls2k1000.uImage: kernel-ls2k1000 ls2k1000-mkimage
	@python3 scripts/elf-to-uimage.py --platform ls2k1000 -n "SudoOS-LS2K1000" kernel-ls2k1000 $@
	@ls -lh $@

# PR-0: board image buildinfo (git commit / toolchain / vendored alloc hashes /
# ELF hash). Copy next to the other board artifacts and append the uImage hash
# so the exact image can always be tied back to the committed sources.
kernel-ls2k1000.buildinfo: kernel-ls2k1000.uImage
	@cp build/loongarch64/cargo/loongarch64-unknown-none-softfloat/release/myos-kernel.buildinfo $@
	@echo "uImage_sha256=$$(python3 -c "import hashlib; print(hashlib.sha256(open('kernel-ls2k1000.uImage','rb').read()).hexdigest())")" >> $@
	@cat $@

check-ls2k1000-image: kernel-ls2k1000.elf kernel-ls2k1000.bin kernel-ls2k1000.uImage
	@python3 scripts/check-ls2k1000-image.py \
	    --elf kernel-ls2k1000.elf \
	    --bin kernel-ls2k1000.bin \
	    --image kernel-ls2k1000.uImage

# SUDOOS_LS2K_STAGE4_V1: external initramfs bundle (kernel uImage + BusyBox
# cpio + DTB carrying linux,initrd-start/end). The vendor U-Boot has no raw
# initrd support, so the kernel locates the archive through /chosen instead of
# images->initrd_start/end.
.PHONY: ls2k1000-stage4.dtb check-ls2k1000-stage4 ls2k1000-stage4-bundle
ls2k1000-stage4.dtb: busybox-initramfs-loongarch64
	@test -s build/initramfs/busybox-loongarch64.cpio || (echo "error: initramfs build failed" >&2; exit 2)
	@INITRD=build/initramfs/busybox-loongarch64.cpio INITRD_PHYS_ADDR=0x0b000000 scripts/build-ls2k1000-dtb.sh
	@cp build/host-tools/ls2k1000/ls2k1000-stage4.dtb $@
	@ls -lh $@

check-ls2k1000-stage4: kernel-ls2k1000.uImage ls2k1000-stage4.dtb
	@python3 scripts/m14-busybox-artifact-audit.py build/initramfs/busybox-loongarch64.cpio
	@echo "LS2K1000 stage-4 bundle OK"

ls2k1000-stage4-bundle: kernel-ls2k1000.uImage busybox-initramfs-loongarch64 ls2k1000-stage4.dtb check-ls2k1000-stage4

# C5: contest fixture bundle for the LS2K1000 board. Builds the kernel uImage,
# a DTB whose /reserved-memory carries contest-disk@e0000000
# (compatible = "sudoos,boot-ramdisk"), the disposable ext4 fixture, and a
# U-Boot boot script. The kernel registers /dev/ram0 over that region.
.PHONY: ls2k1000-contest-fixture-bundle
ls2k1000-contest-fixture-bundle: kernel-ls2k1000.uImage
	@mkdir -p build/fixtures
	@bash scripts/make-contest-fixture.sh --arch loongarch64 --output build/fixtures/contest-la.ext4
	@CONTEST_DISK=0xe0000000 CONTEST_DISK_SIZE=0x02000000 \
	    BOOTARGS="console=ttyS0,115200n8 sudoos.contest.dev=ram0" \
	    DTB_NAME=ls2k1000-contest-fixture \
	    scripts/build-ls2k1000-dtb.sh
	@cp build/host-tools/ls2k1000/ls2k1000-contest-fixture.dtb ls2k1000-contest-fixture.dtb
	@cp build/fixtures/contest-la.ext4 contest-la.ext4
	@printf '%s\n' \
	    "SudoOS LS2K1000 contest fixture boot (ram0, CodePlan C5)" \
	    "1. make ls2k1000-contest-fixture-bundle" \
	    "2. Copy kernel-ls2k1000.uImage, ls2k1000-contest-fixture.dtb, contest-la.ext4 to a FAT USB drive." \
	    "3. U-Boot (cached-VA addressing):" \
	    "     fatload usb 0:1 0x9000000002000000 kernel-ls2k1000.uImage" \
	    "     fatload usb 0:1 0x900000000a000000 ls2k1000-contest-fixture.dtb" \
	    "     fatload usb 0:1 0x90000000e0000000 contest-la.ext4" \
	    "     bootm 0x9000000002000000 - 0x900000000a000000" \
	    "4. Serial: expect 'registered=/dev/ram0', CONTEST_FIXTURE: arch=loongarch64, FIXTURE_OSCOMP_PASS" \
	    > ls2k1000-contest-fixture-boot.txt
	@ls -lh kernel-ls2k1000.uImage ls2k1000-contest-fixture.dtb contest-la.ext4 ls2k1000-contest-fixture-boot.txt

# C9: LS2K1000 contest-fixture boot configs (single / smp). The DTB carries
# the boot-ramdisk reserved-memory node and fixture bootargs (ram0).
.PHONY: ls2k1000-contest-fixture-configs
ls2k1000-contest-fixture-configs: kernel-ls2k1000.uImage
	@CONTEST_DISK=0xe0000000 CONTEST_DISK_SIZE=0x02000000 \
	    BOOTARGS="console=ttyS0,115200n8 sudoos.oscomp=preliminary sudoos.contest.dev=ram0 sudoos.contest.fixture=1 sudoos.maxcpus=1" \
	    DTB_NAME=ls2k1000-contest-fixture-single \
	    scripts/build-ls2k1000-dtb.sh
	@CONTEST_DISK=0xe0000000 CONTEST_DISK_SIZE=0x02000000 \
	    BOOTARGS="console=ttyS0,115200n8 sudoos.oscomp=preliminary sudoos.contest.dev=ram0 sudoos.contest.fixture=1 sudoos.maxcpus=2" \
	    DTB_NAME=ls2k1000-contest-fixture-smp \
	    scripts/build-ls2k1000-dtb.sh
	@cp build/host-tools/ls2k1000/ls2k1000-contest-fixture-single.dtb ls2k1000-contest-fixture-single.dtb
	@cp build/host-tools/ls2k1000/ls2k1000-contest-fixture-smp.dtb ls2k1000-contest-fixture-smp.dtb
	@echo "LS2K1000 contest fixture configs ready (single/smp)"

# K4.1: 正式镜像动态打包。CONTEST_IMAGE 指定实际 .img —— 大小按 512 对齐并
# 校验落在 RAM 内、不与 kernel/DTB/U-Boot 暂存重叠；DTB reserved-memory 用
# 计算后大小；bootargs 用 final-all（不用 preliminary/fixture=1）。
.PHONY: ls2k1000-contest-final-all-bundle
ls2k1000-contest-final-all-bundle: kernel-ls2k1000.uImage
	@test -n "$(CONTEST_IMAGE)" || { echo "error: CONTEST_IMAGE=/path/to/official.img required"; exit 1; }
	@mkdir -p build/fixtures
	@CONTEST_DISK=0xe0000000 CONTEST_IMAGE=$(CONTEST_IMAGE) \
	    BOOTARGS="console=ttyS0,115200n8 sudoos.oscomp=final-all sudoos.contest.dev=ram0" \
	    DTB_NAME=ls2k1000-contest-final-all \
	    scripts/build-ls2k1000-dtb.sh
	@cp build/host-tools/ls2k1000/ls2k1000-contest-final-all.dtb ls2k1000-contest-final-all.dtb
	@cp $(CONTEST_IMAGE) ls2k1000-contest-final-all.img
	@printf '%s\n' \
	    "U-Boot (cached-VA):" \
	    "  fatload usb 0:1 0x9000000002000000 kernel-ls2k1000.uImage" \
	    "  fatload usb 0:1 0x900000000a000000 ls2k1000-contest-final-all.dtb" \
	    "  fatload usb 0:1 0x90000000e0000000 ls2k1000-contest-final-all.img" \
	    "  bootm 0x9000000002000000 - 0x900000000a000000" \
	    "bootargs: sudoos.oscomp=final-all sudoos.contest.dev=ram0" > ls2k1000-contest-final-all-boot.txt
	@ls -lh kernel-ls2k1000.uImage ls2k1000-contest-final-all.dtb ls2k1000-contest-final-all.img ls2k1000-contest-final-all-boot.txt

# K5.2: LS2K1000 正式 final-all 配置（ram0，single/smp）。不用 preliminary、
# 不用 fixture=1。ram0 保留区大小默认 32 MiB；传 CONTEST_IMAGE 或
# CONTEST_DISK_SIZE 可覆盖（正式镜像用 ls2k1000-contest-final-all-bundle）。
.PHONY: ls2k1000-contest-final-all-configs
ls2k1000-contest-final-all-configs: kernel-ls2k1000.uImage
	@CONTEST_DISK=0xe0000000 CONTEST_DISK_SIZE=$(or $(CONTEST_DISK_SIZE),0x02000000) CONTEST_IMAGE=$(CONTEST_IMAGE) \
	    BOOTARGS="console=ttyS0,115200n8 sudoos.oscomp=final-all sudoos.contest.dev=ram0 sudoos.maxcpus=1" \
	    DTB_NAME=ls2k1000-contest-final-all-single \
	    scripts/build-ls2k1000-dtb.sh
	@CONTEST_DISK=0xe0000000 CONTEST_DISK_SIZE=$(or $(CONTEST_DISK_SIZE),0x02000000) CONTEST_IMAGE=$(CONTEST_IMAGE) \
	    BOOTARGS="console=ttyS0,115200n8 sudoos.oscomp=final-all sudoos.contest.dev=ram0 sudoos.maxcpus=2" \
	    DTB_NAME=ls2k1000-contest-final-all-smp \
	    scripts/build-ls2k1000-dtb.sh
	@cp build/host-tools/ls2k1000/ls2k1000-contest-final-all-single.dtb ls2k1000-contest-final-all-single.dtb
	@cp build/host-tools/ls2k1000/ls2k1000-contest-final-all-smp.dtb ls2k1000-contest-final-all-smp.dtb
	@echo "LS2K1000 contest final-all configs ready (single/smp)"

# SUDOOS_LS2K_GATEB_V1: rdinit=/init variant of the stage-4 DTB. Same layout
# and initrd placement as ls2k1000-stage4, but /chosen/bootargs carries
# "rdinit=/init init.debug=1" so the kernel boots the real /init as PID 1
# instead of the self-test sequence. The plain ls2k1000-stage4.dtb is kept as
# the Gate A regression baseline.
.PHONY: ls2k1000-stage4-init.dtb
ls2k1000-stage4-init.dtb: busybox-initramfs-loongarch64
	@test -s build/initramfs/busybox-loongarch64.cpio || (echo "error: initramfs build failed" >&2; exit 2)
	@INITRD=build/initramfs/busybox-loongarch64.cpio INITRD_PHYS_ADDR=0x0b000000 DTB_NAME=ls2k1000-stage4-init \
	    BOOTARGS="console=ttyS0,115200n8 rdinit=/init init.debug=1" scripts/build-ls2k1000-dtb.sh
	@cp build/host-tools/ls2k1000/ls2k1000-stage4-init.dtb $@
	@ls -lh $@

# 别名（板卡更新菜单 / 'go' 命令沿用旧名）
.PHONY: kernel.bin uImage
kernel.bin: kernel-ls2k1000.bin
	@cp kernel-ls2k1000.bin $@

uImage: kernel-ls2k1000.uImage
	@cp kernel-ls2k1000.uImage $@

# VisionFive 2 (riscv64): uImage 供 U-Boot 'bootm' (arch=26, load=entry=0x40200000)
uImage-vf2: kernel-visionfive2
	@python3 scripts/elf-to-uimage.py --arch riscv -n "MyOS-VisionFive2" kernel-visionfive2 $@
	@ls -lh $@

# VisionFive 2 raw 二进制,仅供 U-Boot 'go' 快速诊断 (不传 FDT,内核会停在早期)
kernel-vf2.bin: kernel-visionfive2
	@python3 scripts/elf-to-uimage.py --raw kernel-visionfive2 $@
	@ls -lh $@

# VisionFive 2 镜像检查:ELF/raw 与板级物理布局一致 (entry/trampoline/LMA/DTB 分离)
kernel-visionfive2.elf: kernel-visionfive2
	@cp kernel-visionfive2 $@

.PHONY: check-visionfive2-image
check-visionfive2-image: kernel-visionfive2.elf kernel-vf2.bin
	@python3 scripts/check-visionfive2-image.py \
	    --elf kernel-visionfive2.elf \
	    --bin kernel-vf2.bin

# SUDOOS_VF2_FIT_V1: VisionFive 2 FIT/TFTP bundle (CodePlan VF2.6).
# 外部完整板级 DTB 由 VISIONFIVE2_DTB 提供;构建器只派生三个 bootargs 变体。
VISIONFIVE2_DTB ?=
PCB ?= unknown
VF2_TFTP_DIR := build/visionfive2/tftp/sudoos/vf2

.PHONY: visionfive2-dtbs
visionfive2-dtbs:
	@test -n "$(VISIONFIVE2_DTB)" || (echo "error: VISIONFIVE2_DTB=/absolute/path/to/board.dtb is required" >&2; exit 2)
	@test -f "$(VISIONFIVE2_DTB)" || (echo "error: VISIONFIVE2_DTB not found: $(VISIONFIVE2_DTB)" >&2; exit 2)
	VISIONFIVE2_DTB="$(VISIONFIVE2_DTB)" scripts/build-visionfive2-dtb.sh

.PHONY: visionfive2-fit
visionfive2-fit: kernel-visionfive2 busybox-initramfs-riscv64 visionfive2-dtbs
	@mkdir -p $(VF2_TFTP_DIR)
	@python3 scripts/elf-to-uimage.py --raw kernel-visionfive2 $(VF2_TFTP_DIR)/kernel-vf2.bin >/dev/null
	KERNEL_RAW="$(CURDIR)/$(VF2_TFTP_DIR)/kernel-vf2.bin" \
	KERNEL_ELF="$(CURDIR)/kernel-visionfive2" \
	INITRAMFS="$(CURDIR)/build/initramfs/busybox-riscv64.cpio" \
	VISIONFIVE2_DTB="$(VISIONFIVE2_DTB)" PCB="$(PCB)" \
	scripts/build-visionfive2-fit.sh

.PHONY: check-visionfive2-fit
check-visionfive2-fit: visionfive2-fit
	@python3 scripts/check-visionfive2-fit.py \
	    --itb $(VF2_TFTP_DIR)/sudoos-visionfive2.itb \
	    --kernel-raw $(VF2_TFTP_DIR)/kernel-vf2.bin \
	    --dtb-selftest $(VF2_TFTP_DIR)/dtbs/vf2-selftest.dtb \
	    --dtb-single $(VF2_TFTP_DIR)/dtbs/vf2-single.dtb \
	    --dtb-smp $(VF2_TFTP_DIR)/dtbs/vf2-smp.dtb \
	    --initramfs build/initramfs/busybox-riscv64.cpio

.PHONY: visionfive2-tftp-bundle
visionfive2-tftp-bundle: check-visionfive2-fit
	@scripts/build-visionfive2-uboot-script.sh
	@echo "=== VisionFive 2 TFTP bundle ==="
	@ls -lh $(VF2_TFTP_DIR)/sudoos-visionfive2.itb $(VF2_TFTP_DIR)/sudoos-vf2-tftp.cmd $(VF2_TFTP_DIR)/sudoos-vf2-tftp.scr $(VF2_TFTP_DIR)/visionfive2-manifest.txt

.PHONY: visionfive2-tftp-install
visionfive2-tftp-install: visionfive2-tftp-bundle
	@test -n "$(TFTP_ROOT)" || (echo "error: TFTP_ROOT=/path/to/tftp/root is required" >&2; exit 2)
	@mkdir -p "$(TFTP_ROOT)/sudoos/vf2"
	@cp $(VF2_TFTP_DIR)/sudoos-visionfive2.itb $(VF2_TFTP_DIR)/sudoos-vf2-tftp.cmd $(VF2_TFTP_DIR)/sudoos-vf2-tftp.scr $(VF2_TFTP_DIR)/visionfive2-manifest.txt "$(TFTP_ROOT)/sudoos/vf2/"
	@echo "installed: $(TFTP_ROOT)/sudoos/vf2/"

# Original build target (single architecture, uses current defaults)
.PHONY: build
build:
	@./scripts/build.sh

.PHONY: run
run:
	@./scripts/run-qemu.sh

.PHONY: debug
debug:
	@QEMU_DEBUG=1 ./scripts/run-qemu.sh

.PHONY: build-riscv64
build-riscv64:
	@ARCH=riscv64 PLATFORM=qemu-virt ./scripts/build.sh

.PHONY: build-loongarch64
build-loongarch64:
	@ARCH=loongarch64 PLATFORM=$(PLATFORM) ./scripts/build.sh

.PHONY: build-ls2k1000
build-ls2k1000:
	@ARCH=loongarch64 PLATFORM=ls2k1000 ./scripts/build.sh

.PHONY: build-visionfive2
build-visionfive2:
	@ARCH=riscv64 PLATFORM=visionfive2 ./scripts/build.sh

.PHONY: run-riscv64
run-riscv64:
	@ARCH=riscv64 ./scripts/run-qemu.sh

.PHONY: run-loongarch64
run-loongarch64:
	@ARCH=loongarch64 ./scripts/run-qemu.sh

.PHONY: smoke
smoke:
	@./scripts/smoke.py --arch "$(ARCH)" --profile "$(PROFILE)" --timeout "$(SMOKE_TIMEOUT)"

.PHONY: smoke-riscv64
smoke-riscv64:
	@./scripts/smoke.py --arch riscv64 --profile "$(PROFILE)" --timeout "$(SMOKE_TIMEOUT)"

.PHONY: smoke-loongarch64
smoke-loongarch64:
	@./scripts/smoke.py --arch loongarch64 --profile "$(PROFILE)" --timeout "$(SMOKE_TIMEOUT)"

.PHONY: smoke-all
smoke-all: smoke-riscv64 smoke-loongarch64

.PHONY: smoke-smp-riscv64
smoke-smp-riscv64:
	@SMP=4 ./scripts/smoke.py --arch riscv64 --profile "$(PROFILE)" --timeout "$(SMP_SMOKE_TIMEOUT)"

.PHONY: smoke-smp-loongarch64
smoke-smp-loongarch64:
	@SMP=4 ./scripts/smoke.py --arch loongarch64 --profile "$(PROFILE)" --timeout "$(SMP_SMOKE_TIMEOUT)"

.PHONY: smoke-smp-all
smoke-smp-all: smoke-smp-riscv64 smoke-smp-loongarch64

.PHONY: stress-smp
stress-smp:
	@./scripts/stress-smp.sh

.PHONY: fmt
fmt:
	@cargo fmt --all

.PHONY: fmt-check
fmt-check:
	@cargo fmt --all -- --check

.PHONY: test
test:
	@cargo test \
		-p myos-boot \
		-p myos-runtime \
		-p myos-fdt \
		-p myos-mm \
		-p myos-vfs \
		-p myos-sync

.PHONY: clippy
clippy: clippy-riscv64 clippy-loongarch64 clippy-host

.PHONY: clippy-riscv64 clippy-riscv64-qemu clippy-riscv64-visionfive2
clippy-riscv64: clippy-riscv64-qemu clippy-riscv64-visionfive2

# RISC-V 平台严格互斥:每个 clippy 目标显式启用恰好一个平台 feature。
clippy-riscv64-qemu:
	@cargo clippy \
		--manifest-path Cargo.toml \
		--package "$(KERNEL_PACKAGE)" \
		--bin "$(KERNEL_BINARY)" \
		--target riscv64imac-unknown-none-elf \
		--no-default-features \
		--features platform-qemu-virt \
		-Z build-std=core,alloc \
		-Z build-std-features=compiler-builtins-mem \
		-- -D warnings $(CLIPPY_ALLOW)

clippy-riscv64-visionfive2:
	@cargo clippy \
		--manifest-path Cargo.toml \
		--package "$(KERNEL_PACKAGE)" \
		--bin "$(KERNEL_BINARY)" \
		--target riscv64imac-unknown-none-elf \
		--no-default-features \
		--features platform-visionfive2 \
		-Z build-std=core,alloc \
		-Z build-std-features=compiler-builtins-mem \
		-- -D warnings $(CLIPPY_ALLOW)

.PHONY: clippy-loongarch64
clippy-loongarch64:
	@cargo clippy \
		--manifest-path Cargo.toml \
		--package "$(KERNEL_PACKAGE)" \
		--bin "$(KERNEL_BINARY)" \
		--target loongarch64-unknown-none-softfloat \
		-Z build-std=core,alloc \
		-Z build-std-features=compiler-builtins-mem \
		-- -D warnings $(CLIPPY_ALLOW)

.PHONY: clippy-host
clippy-host:
	@cargo clippy \
		-p myos-boot \
		-p myos-runtime \
		-p myos-fdt \
		-p myos-mm \
		-p myos-vfs \
		-p myos-sync \
		--all-targets \
		-- -D warnings $(CLIPPY_ALLOW)

.PHONY: source-tree-check
source-tree-check:
	@./scripts/check-source-tree.sh

.PHONY: m9-audit
m9-audit:
	@python3 scripts/m8-audit.py
	@python3 scripts/m8b3-audit.py
	@python3 scripts/m8b4-audit.py
	@python3 scripts/m8-linuxlike-audit.py "$(CURDIR)"
	@python3 scripts/m9a-audit.py
	@python3 scripts/m9b-audit.py

.PHONY: check
check: source-tree-check fmt-check test harness-test m9-audit build-riscv64 build-loongarch64 clippy

.PHONY: verify
verify: check smoke-all smoke-smp-all

.PHONY: harness-test
harness-test:
	@python3 scripts/test-smoke-harness.py

.PHONY: m5-quick
m5-quick:
	@python3 scripts/m5-verify.py --level quick

.PHONY: m5-full
m5-full:
	@python3 scripts/m5-verify.py --level full

.PHONY: m5-release
m5-release:
	@M5_SOAK_LOOPS="$(M5_SOAK_LOOPS)" M5_RELEASE_SOAK_LOOPS="$(M5_RELEASE_SOAK_LOOPS)" python3 scripts/m5-verify.py --level soak --require-clean

.PHONY: m5-tag
m5-tag:
	@./scripts/m5-tag.sh

.PHONY: clean
clean:
	@rm -rf build
	@echo "Removed build directory"

.PHONY: doctor
doctor:
	@echo "Checking Rust toolchain..."
	@command -v rustup >/dev/null || \
		(echo "error: rustup is not installed" && exit 1)
	@command -v cargo >/dev/null || \
		(echo "error: cargo is not installed" && exit 1)
	@command -v rustc >/dev/null || \
		(echo "error: rustc is not installed" && exit 1)
	@command -v python3 >/dev/null || \
		(echo "error: python3 is not installed" && exit 1)

	@echo "Checking QEMU..."
	@command -v qemu-system-riscv64 >/dev/null || \
		echo "warning: qemu-system-riscv64 was not found"
	@command -v qemu-system-loongarch64 >/dev/null || \
		echo "warning: qemu-system-loongarch64 was not found"

	@echo "Checking project scripts..."
	@test -x scripts/build.sh || \
		echo "warning: scripts/build.sh is not executable"
	@test -x scripts/run-qemu.sh || \
		echo "warning: scripts/run-qemu.sh is not executable"
	@test -x scripts/smoke.py || \
		echo "warning: scripts/smoke.py is not executable"
	@test -x scripts/stress-smp.sh || \
		echo "warning: scripts/stress-smp.sh is not executable"
	@test -x scripts/check-source-tree.sh || \
		echo "warning: scripts/check-source-tree.sh is not executable"

	@echo "Doctor check completed"

.PHONY: help
help:
	@echo "SudoOS build commands"
	@echo ""
	@echo "  make kernel-rv          RISC-V QEMU virt (release)"
	@echo "  make kernel-visionfive2 RISC-V VisionFive 2 board (release)"
	@echo "  make kernel-la          LoongArch QEMU virt (release)"
	@echo "  make kernel-ls2k1000    LoongArch 2K1000 board (release)"
	@echo "  make uImage-vf2         VisionFive 2 uImage (arch=26, load=0x40200000)"
	@echo "  make all                All platform artifacts"
	@echo ""
	@echo "  make build ARCH=riscv64"
	@echo "  make build ARCH=loongarch64"
	@echo "  make build-loongarch64 PLATFORM=ls2k1000"
	@echo "  make build-ls2k1000"
	@echo "  make build-visionfive2"
	@echo ""
	@echo "  make run ARCH=riscv64"
	@echo "  make run ARCH=loongarch64"
	@echo ""
	@echo "  make smoke ARCH=riscv64"
	@echo "  make smoke-all"
	@echo "  make smoke-smp-all"
	@echo "  make stress-smp"
	@echo "  make check"
	@echo "  make verify"
	@echo ""
	@echo "  make debug ARCH=riscv64"
	@echo "  make debug ARCH=loongarch64"
	@echo ""
	@echo "Variables:"
	@echo "  ARCH=riscv64|loongarch64"
	@echo "  PLATFORM=qemu-virt|ls2k1000|visionfive2  (default: ls2k1000 for loongarch64, qemu-virt for riscv64)"
	@echo "  PROFILE=debug|release"
	@echo "  SMP=<cpu count>"
	@echo "  MEM=<memory size>"
	@echo "  SMOKE_TIMEOUT=<seconds>"
	@echo "  SMP_SMOKE_TIMEOUT=<seconds>"
	@echo "  STRESS_ARCHES='<arch list>'"
	@echo "  STRESS_SMPS='<cpu count list>'"
	@echo "  STRESS_MEMS='<memory size list>'"
	@echo "  STRESS_PROFILES='<profile list>'"
	@echo "  STRESS_LOOPS=<count>"
	@echo "  STRESS_TIMEOUT=<seconds>"
	@echo "  QEMU_ARGS='<additional arguments>'"

# M6-C closure: reproducible local release gate.
M6_SOAK_LOOPS ?= 50
M6_RELEASE_SOAK_LOOPS ?= 10
export M6_SOAK_LOOPS
export M6_RELEASE_SOAK_LOOPS

.PHONY: m6-audit
m6-audit:
	@python3 scripts/m6-audit.py

.PHONY: m6-quick
m6-quick:
	@python3 scripts/m6-verify.py --level quick

.PHONY: m6-full
m6-full:
	@python3 scripts/m6-verify.py --level full

.PHONY: m6-soak
m6-soak:
	@M6_SOAK_LOOPS="$(M6_SOAK_LOOPS)" \
	 M6_RELEASE_SOAK_LOOPS="$(M6_RELEASE_SOAK_LOOPS)" \
	 python3 scripts/m6-verify.py --level soak

.PHONY: m6-release
m6-release:
	@M6_SOAK_LOOPS="$(M6_SOAK_LOOPS)" \
	 M6_RELEASE_SOAK_LOOPS="$(M6_RELEASE_SOAK_LOOPS)" \
	 python3 scripts/m6-verify.py --level release

.PHONY: m6-tag
m6-tag:
	@./scripts/m6-tag.sh

# M7-B closure: privilege, syscall, checked-copy and user-fault release gate.
M7_SOAK_LOOPS ?= 50
M7_RELEASE_SOAK_LOOPS ?= 10

export M7_SOAK_LOOPS
export M7_RELEASE_SOAK_LOOPS

.PHONY: m7-audit
m7-audit:
	@python3 scripts/m7-audit.py

.PHONY: m7-quick
m7-quick:
	@python3 scripts/m7-verify.py --level quick

.PHONY: m7-full
m7-full:
	@python3 scripts/m7-verify.py --level full

.PHONY: m7-soak
m7-soak:
	@M7_SOAK_LOOPS="$(M7_SOAK_LOOPS)" \
		M7_RELEASE_SOAK_LOOPS="$(M7_RELEASE_SOAK_LOOPS)" \
		python3 scripts/m7-verify.py --level soak

.PHONY: m7-release
m7-release:
	@M7_SOAK_LOOPS="$(M7_SOAK_LOOPS)" \
		M7_RELEASE_SOAK_LOOPS="$(M7_RELEASE_SOAK_LOOPS)" \
		python3 scripts/m7-verify.py --level release

.PHONY: m7-tag
m7-tag:
	@./scripts/m7-tag.sh

# SUDOOS_M16_PRE_PATCH_V1: global M14/M15/M16 convergence gates.
.PHONY: m16-preflight verify-m16-pre
m16-preflight:
	python3 scripts/m16-preflight-audit.py

verify-m16-pre: check smoke-all smoke-smp-all m16-preflight
	@echo "M16-pre verifier complete"

# SUDOOS_M16A_ELF_AUXV_PATCH_V1: M16-A ELF metadata and auxv gate.
.PHONY: m16a-audit
m16a-audit:
	python3 scripts/m16a-elf-auxv-audit.py

# SUDOOS_M15A_EXT4_RO_PATCH_V1: read-only ext4 VFS snapshot gate.
.PHONY: m15a-ext4-ro-audit verify-m15a-ext4-ro
m15a-ext4-ro-audit:
	python3 scripts/m15a-ext4-ro-audit.py

verify-m15a-ext4-ro: m15a-ext4-ro-audit check smoke-all smoke-smp-all m16-preflight
	@echo "M15-A ext4 read-only verifier complete"

.PHONY: busybox-initramfs m14-busybox-artifact-audit verify-m14-busybox
BUSYBOX_INITRAMFS ?= build/initramfs/busybox.cpio

busybox-initramfs:
	@test -n "$(BUSYBOX)" || (echo "error: BUSYBOX=/absolute/path/to/static/busybox is required" >&2; exit 2)
	OUT="$(BUSYBOX_INITRAMFS)" BUSYBOX="$(BUSYBOX)" scripts/build-static-busybox-initramfs.sh

m14-busybox-artifact-audit:
	python3 scripts/m14-busybox-artifact-audit.py

verify-m14-busybox: m14-busybox-artifact-audit busybox-initramfs
	python3 scripts/m14-busybox-artifact-audit.py "$(BUSYBOX_INITRAMFS)"

# SUDOOS_M14_DUAL_VENDOR_USERLAND_PATCH_V1: dual-arch vendor BusyBox artifact gates.
.PHONY: m14-vendor-userland-audit m14-vendor-userland-audit-strict busybox-initramfs-vendor busybox-initramfs-vendor-all smoke-riscv64-vendor-initramfs smoke-riscv64-sdcard smoke-loongarch64-sdcard smoke-sdcard-all verify-m14-vendor-userland

BUSYBOX_ARCH ?= riscv64
VENDOR_BUSYBOX ?= vendor/userland/$(BUSYBOX_ARCH)/busybox-static
VENDOR_BUSYBOX_INITRAMFS ?= build/initramfs/busybox-$(BUSYBOX_ARCH).cpio

m14-vendor-userland-audit:
	python3 scripts/m14-vendor-userland-audit.py

m14-vendor-userland-audit-strict:
	python3 scripts/m14-vendor-userland-audit.py --strict

busybox-initramfs-vendor:
	@test -x "$(VENDOR_BUSYBOX)" || (echo "error: missing executable $(VENDOR_BUSYBOX)" >&2; exit 2)
	@mkdir -p build/initramfs
	OUT="$(VENDOR_BUSYBOX_INITRAMFS)" BUSYBOX="$(VENDOR_BUSYBOX)" scripts/build-static-busybox-initramfs.sh
	python3 scripts/m14-busybox-artifact-audit.py "$(VENDOR_BUSYBOX_INITRAMFS)"

busybox-initramfs-vendor-all:
	@set -e; \
	found=0; \
	for arch in riscv64 loongarch64; do \
	  bb="vendor/userland/$$arch/busybox-static"; \
	  out="build/initramfs/busybox-$$arch.cpio"; \
	  if [ -x "$$bb" ]; then \
	    found=1; \
	    echo "building $$out from $$bb"; \
	    mkdir -p build/initramfs; \
	    OUT="$$out" BUSYBOX="$$bb" scripts/build-static-busybox-initramfs.sh; \
	    python3 scripts/m14-busybox-artifact-audit.py "$$out"; \
	  else \
	    echo "warn: skipping $$arch BusyBox artifact; missing executable $$bb"; \
	  fi; \
	done; \
	if [ "$$found" = 0 ]; then echo "error: no vendor BusyBox artifact found" >&2; exit 2; fi

# SUDOOS_LS2K_STAGE4_V1: explicit loongarch64 BusyBox initramfs target.
# Output: build/initramfs/busybox-loongarch64.cpio (newc, rootless, deterministic).
.PHONY: busybox-initramfs-loongarch64
busybox-initramfs-loongarch64:
	$(MAKE) BUSYBOX_ARCH=loongarch64 busybox-initramfs-vendor

# SUDOOS_VF2_INITRAMFS_V1: explicit riscv64 BusyBox initramfs target for the
# VisionFive 2 FIT. Same deterministic newc builder as loongarch64, then both
# the generic m14 audit and the RISC-V/VF2-specific audit (ELF64 EM_RISCV,
# static no PT_INTERP, Gate applets).
.PHONY: busybox-initramfs-riscv64
busybox-initramfs-riscv64:
	$(MAKE) BUSYBOX_ARCH=riscv64 busybox-initramfs-vendor
	python3 scripts/vf2-busybox-audit.py \
	    --busybox vendor/userland/riscv64/busybox-static \
	    --cpio build/initramfs/busybox-riscv64.cpio

smoke-riscv64-vendor-initramfs:
	$(MAKE) BUSYBOX_ARCH=riscv64 busybox-initramfs-vendor
	QEMU_ARGS="-initrd build/initramfs/busybox-riscv64.cpio" $(MAKE) smoke-riscv64

# Gate C 4.8.18: PID 1 interruptible-wait regression through a real RISC-V
# QEMU boot of BusyBox /init. The syscall/process code under test
# (user.rs / task/mod.rs / task/wait_queue.rs / process.rs) is shared across
# architectures, so this exercises the same fork -> parent wait4 blocks ->
# sysinit child exits -> parent woken -> reap -> init reaches askfirst chain
# that deadlocked on the LS2K1000 board (4.8.17 recursive SCHEDULER lock).
# Requires qemu-system-riscv64: run inside WSL.
.PHONY: gate-c-wait4-smoke
gate-c-wait4-smoke: kernel-rv
	$(MAKE) BUSYBOX_ARCH=riscv64 busybox-initramfs-vendor
	python3 scripts/gate-c-wait4-smoke.py --skip-build

smoke-riscv64-sdcard:
	@test -f sdcard-rv.img || (echo "error: missing sdcard-rv.img" >&2; exit 2)
	QEMU_ARGS="-drive file=sdcard-rv.img,if=none,format=raw,id=hd0,readonly=on -device virtio-blk-device,drive=hd0" $(MAKE) smoke-riscv64

smoke-loongarch64-sdcard:
	@test -f sdcard-la.img || (echo "error: missing sdcard-la.img" >&2; exit 2)
	QEMU_ARGS="-drive file=sdcard-la.img,if=none,format=raw,id=hd0,readonly=on -device virtio-blk-pci,drive=hd0" $(MAKE) smoke-loongarch64

smoke-sdcard-all: smoke-riscv64-sdcard smoke-loongarch64-sdcard

# ── C3: disposable ext4 contest fixture smoke ─────────────────────────────
# Generates a 32 MiB raw ext4 fixture (make-contest-fixture.sh), validates it
# on the host (check-contest-fixture.py), boots the kernel with it attached,
# and requires CONTEST_FIXTURE: arch=<arch> + FIXTURE_OSCOMP_PASS. Exercises
# BlockDevice -> ext4 -> VFS mount -> file reads on QEMU without an official
# judge image. The loongarch target additionally requires the parked
# qemu-loongarch direct-boot FDT fallback to boot the kernel.
FIXTURE_DIR := build/fixtures
FIXTURE_LOG_DIR := build/fixtures/logs

.PHONY: smoke-contest-fixture-riscv64 smoke-contest-fixture-loongarch64 smoke-contest-fixture-all
smoke-contest-fixture-riscv64: kernel-rv
	@mkdir -p $(FIXTURE_DIR) $(FIXTURE_LOG_DIR)
	@bash scripts/make-contest-fixture.sh --arch riscv64 --output $(FIXTURE_DIR)/contest-rv.ext4
	@python3 scripts/check-contest-fixture.py --arch riscv64 --image $(FIXTURE_DIR)/contest-rv.ext4
	@python3 scripts/qemu_log_wait.py --log $(FIXTURE_LOG_DIR)/contest-rv.log \
		--success-pattern "CONTEST_FIXTURE: arch=riscv64" \
		--success-pattern "FIXTURE_OSCOMP_PASS" \
		--failure-regex '^panicked at .*' --timeout 90 -- \
		qemu-system-riscv64 -machine virt -kernel kernel-rv -m 256M -nographic -smp 1 \
		-bios default \
		-drive file=$(FIXTURE_DIR)/contest-rv.ext4,if=none,format=raw,id=x0 \
		-device virtio-blk-device,drive=x0,bus=virtio-mmio-bus.0 \
		-no-reboot -monitor none -display none -serial file:$(FIXTURE_LOG_DIR)/contest-rv.log

smoke-contest-fixture-loongarch64: kernel-la
	@mkdir -p $(FIXTURE_DIR) $(FIXTURE_LOG_DIR)
	@bash scripts/make-contest-fixture.sh --arch loongarch64 --output $(FIXTURE_DIR)/contest-la.ext4
	@python3 scripts/check-contest-fixture.py --arch loongarch64 --image $(FIXTURE_DIR)/contest-la.ext4
	@python3 scripts/qemu_log_wait.py --log $(FIXTURE_LOG_DIR)/contest-la.log \
		--success-pattern "CONTEST_FIXTURE: arch=loongarch64" \
		--success-pattern "FIXTURE_OSCOMP_PASS" \
		--failure-regex '^panicked at .*' --timeout 90 -- \
		qemu-system-loongarch64 -machine virt -kernel kernel-la -m 2G -nographic -smp 1 \
		-drive file=$(FIXTURE_DIR)/contest-la.ext4,if=none,format=raw,id=x0 \
		-device virtio-blk-pci,drive=x0 \
		-no-reboot -monitor none -display none -serial file:$(FIXTURE_LOG_DIR)/contest-la.log

smoke-contest-fixture-all: smoke-contest-fixture-riscv64 smoke-contest-fixture-loongarch64

verify-m14-vendor-userland: m14-vendor-userland-audit busybox-initramfs-vendor check smoke-all smoke-smp-all smoke-riscv64-vendor-initramfs
	@echo "M14 vendor userland verifier complete"
